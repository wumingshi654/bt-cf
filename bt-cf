CONFIG_PATHS = [
    '/etc/bt-cf/config.json',
    os.path.join(os.path.dirname(os.path.abspath(__file__)), 'config.json'),
    '/www/server/panel/plugin/cloudflare_helper/config.json'
]

class CloudflareManager:
    def __init__(self, override_ip=None):
        self.config_file = CONFIG_PATHS[0]
        for p in CONFIG_PATHS:
            if os.path.exists(p):
                self.config_file = p
                break
        self.conf = self.load_config()
        self.override_ip = override_ip
        if requests:
            self.session = requests.Session()
            self.session.trust_env = False
        else:
            self.session = None

    def load_config(self):
        if os.path.exists(self.config_file):
            try:
                with open(self.config_file, 'r') as f:
                    return json.load(f)
            except Exception:
                pass
        return {}

    def save_config(self, conf):
        os.makedirs(os.path.dirname(self.config_file), exist_ok=True)
        with open(self.config_file, 'w') as f:
            json.dump(conf, f, indent=2)
        self.conf = conf

    def get_server_ip(self):
        """优先使用命令行参数指定的 IP，其次配置文件，最后动态检测"""
        if self.override_ip:
            return self.override_ip
        conf_ip = self.conf.get('server_ip', '').strip()
        if conf_ip and conf_ip != '127.0.0.1':
            return conf_ip
        return detect_vps_ip()

    def get_token(self):
        return self.conf.get('api_token', '').strip()

    def get_app_name(self):
        return self.conf.get('app_name', 'APP').strip()

    def cf_request(self, method, endpoint, payload=None):
        """发起 Cloudflare v4 REST API 请求"""
        token = self.get_token()
        if not token:
            return False, "未配置 Cloudflare API Token。请先执行: bt-cf config --token <你的Token>"

        url = "https://api.cloudflare.com/client/v4" + endpoint
        headers = {
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json"
        }

        # 优先使用 requests
        if self.session:
            try:
                data_json = json.dumps(payload) if payload is not None else None
                resp = self.session.request(method.upper(), url, headers=headers, data=data_json, timeout=20)
                try:
                    res_json = resp.json()
                except Exception:
                    return False, f"HTTP {resp.status_code}: 返回非 JSON 内容"

                if resp.status_code in (200, 201) and res_json.get('success', False):
                    return True, res_json.get('result')
                else:
                    err_msgs = [e.get('message', str(e)) for e in res_json.get('errors', [])]
                    msg = "; ".join(err_msgs) if err_msgs else f"HTTP {resp.status_code}: {resp.text[:200]}"
                    return False, msg
            except Exception as e:
                return False, f"请求 Cloudflare 失败: {str(e)}"

        # 回退使用 curl 命令行请求
        try:
            cmd = ['curl', '-4', '--noproxy', '*', '-s', '-X', method.upper(), url]
            for k, v in headers.items():
                cmd.extend(['-H', f'{k}: {v}'])
            if payload is not None:
                cmd.extend(['-d', json.dumps(payload)])

            raw = subprocess.check_output(cmd, timeout=20).decode('utf-8')
            res_json = json.loads(raw)
            if res_json.get('success', False):
                return True, res_json.get('result')
            else:
                err_msgs = [e.get('message', str(e)) for e in res_json.get('errors', [])]
                return False, "; ".join(err_msgs) if err_msgs else raw[:200]
        except Exception as e:
            return False, f"执行请求异常: {str(e)}"

    def get_account_id(self):
        """获取 Cloudflare Account ID (优先配置缓存，其次 /accounts，再次 /zones 关联)"""
        acc_id = self.conf.get('account_id')
        if acc_id:
            return acc_id

        # 尝试从 /accounts 获取
        ok_acc, accounts = self.cf_request('GET', '/accounts')
        if ok_acc and isinstance(accounts, list) and len(accounts) > 0:
            acc_id = accounts[0].get('id')
            if accounts[0].get('name') and not self.conf.get('account_name'):
                self.conf['account_name'] = accounts[0].get('name')

        # 如果 /accounts 返回空 (Scoped API Token 场景)，从 /zones 获取关联 account
        if not acc_id:
            ok_z, zones = self.cf_request('GET', '/zones?per_page=50')
            if ok_z and isinstance(zones, list) and len(zones) > 0:
                for z in zones:
                    acc = z.get('account', {})
                    if acc.get('id'):
                        acc_id = acc.get('id')
                        if acc.get('name') and not self.conf.get('account_name'):
                            self.conf['account_name'] = acc.get('name')
                        break

        if acc_id:
            self.conf['account_id'] = acc_id
            self.save_config(self.conf)
        return acc_id

    def test_connection(self):
        """测试 Token 有效性与 Zero Trust APP 存在性"""
        ok, res = self.cf_request('GET', '/user/tokens/verify')
        if not ok:
            return False, f"Token 验证失败: {res}"

        # 获取绑定的账户
        acc_id = self.get_account_id()
        acc_name = self.conf.get('account_name')

        # 获取 Zone 列表
        ok_z, zones = self.cf_request('GET', '/zones?per_page=50')

        # 获取 Zero Trust App 详情
        app_name = self.get_app_name()
        ok_app, app_data = self.get_access_app(acc_id, app_name)

        return True, {
            "account_id": acc_id,
            "account_name": acc_name,
            "zones": zones if ok_z else [],
            "app": app_data if ok_app else None
        }

    def get_access_app(self, account_id=None, app_name=None):
        """查找指定名称的 Cloudflare Zero Trust (Access) Application"""
        app_name = app_name or self.get_app_name()
        account_id = account_id or self.get_account_id()

        if not account_id:
            return False, "无法获取 Cloudflare Account ID，请检查 API Token 权限"

        ok, apps = self.cf_request('GET', f'/accounts/{account_id}/access/apps')
        if not ok or not isinstance(apps, list):
            return False, f"无法获取 Access Apps: {apps}"

        for app in apps:
            if app.get('name', '').strip().lower() == app_name.lower():
                return True, app

        return False, f"未找到名为 [{app_name}] 的 Zero Trust 应用程序"

    def get_zt_domains(self):
        """获取 Zero Trust 应用程序中已受保护的所有域名"""
        ok_app, app = self.get_access_app()
        if not ok_app or not app:
            return False, app

        domains = []
        primary_domain = app.get('domain', '').strip().lower()
        if primary_domain:
            domains.append(primary_domain)

        destinations = app.get('destinations', []) or []
        for dest in destinations:
            uri = dest.get('uri', '').strip().lower()
            if uri:
                clean_d = re.sub(r'^https?://', '', uri).split('/')[0].split(':')[0]
                if clean_d and clean_d not in domains:
                    domains.append(clean_d)

        return True, {
            "app_id": app.get('id'),
            "app_name": app.get('name'),
            "primary_domain": primary_domain,
            "domains": domains,
            "count": len(domains)
        }

    def toggle_domain_zt(self, domain, action='toggle'):
        """添加或移出 Zero Trust 保护"""
        domain = domain.strip().lower()
        ok_app, app = self.get_access_app()
        if not ok_app or not app:
            return False, f"无法获取 Zero Trust 应用: {app}"

        account_id = self.get_account_id()
        if not account_id:
            return False, "无法获取 Cloudflare Account ID，请检查 API Token 权限"
        app_id = app.get('id')

        # 获取全量配置
        ok_detail, full_app = self.cf_request('GET', f'/accounts/{account_id}/access/apps/{app_id}')
        if not ok_detail:
            full_app = app

        current_destinations = full_app.get('destinations', []) or []
        primary_domain = full_app.get('domain', '').strip().lower()

        # 判断当前是否已在保护中
        existing_uris = set(d.get('uri', '').strip().lower() for d in current_destinations if d.get('uri'))
        is_in_dest = (domain in existing_uris or (domain + '/*') in existing_uris)
        is_primary = (domain == primary_domain)
        currently_in = is_in_dest or is_primary

        if action == 'toggle':
            target_action = 'remove' if currently_in else 'add'
        elif action in ['add', 'on']:
            target_action = 'add'
        else:
            target_action = 'remove'

        if target_action == 'add':
            if currently_in:
                return True, f"域名 [{domain}] 已经在 Zero Trust ({full_app.get('name')}) 保护中。"

            new_destinations = list(current_destinations)
            new_destinations.append({"type": "public", "uri": domain})

            payload = {
                "name": full_app.get('name'),
                "domain": full_app.get('domain'),
                "type": full_app.get('type', 'self_hosted'),
                "session_duration": full_app.get('session_duration', '24h'),
                "destinations": new_destinations
            }
            ok_u, res_u = self.cf_request('PUT', f'/accounts/{account_id}/access/apps/{app_id}', payload)
            if ok_u:
                return True, f"成功将 [{domain}] 加入 Zero Trust ({full_app.get('name')})！"
            return False, f"更新 Zero Trust 失败: {res_u}"

        else:
            if not currently_in:
                return True, f"域名 [{domain}] 本来就不在 Zero Trust 保护中。"

            if is_primary:
                return False, f"域名 [{domain}] 是该 APP 的主域名 (Primary Domain)，Cloudflare 规定主域名不能直接剔除。如需剔除请在 Cloudflare 后台调整主域名。"

            new_destinations = []
            for dest in current_destinations:
                uri = dest.get('uri', '').strip().lower()
                clean = re.sub(r'^https?://', '', uri).split('/')[0].split(':')[0]
                if clean != domain:
                    new_destinations.append(dest)

            payload = {
                "name": full_app.get('name'),
                "domain": full_app.get('domain'),
                "type": full_app.get('type', 'self_hosted'),
                "session_duration": full_app.get('session_duration', '24h'),
                "destinations": new_destinations
            }
            ok_u, res_u = self.cf_request('PUT', f'/accounts/{account_id}/access/apps/{app_id}', payload)
            if ok_u:
                return True, f"成功将 [{domain}] 从 Zero Trust 移出！"
            return False, f"更新 Zero Trust 失败: {res_u}"

    def find_matching_zone(self, domain):
        """根据域名查找 Cloudflare 对应的托管 Zone"""
        domain = re.sub(r'^https?://', '', domain).split(':')[0].strip().lower()
        ok, zones = self.cf_request('GET', '/zones')
        if not ok or not zones:
            # 尝试使用配置里的兜底
            cfg_zone = self.conf.get('zone_name', '').lower()
            cfg_zid = self.conf.get('zone_id')
            if cfg_zone and cfg_zid and (domain == cfg_zone or domain.endswith('.' + cfg_zone)):
                return True, {"id": cfg_zid, "name": cfg_zone}
            return False, f"无法获取 Cloudflare Zones: {zones}"

        best_match = None
        best_len = 0
        for z in zones:
            z_name = z.get('name', '').lower().strip()
            if domain == z_name or domain.endswith('.' + z_name):
                if len(z_name) > best_len:
                    best_match = z
                    best_len = len(z_name)

        if best_match:
            return True, best_match
        return False, f"未在 Cloudflare 找到域名 [{domain}] 对应的托管 Zone"


