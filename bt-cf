        if name and name not in site_domains_map[pid]:
            site_domains_map[pid].append(name)

    proxies_map = get_site_proxies()

    # 2. 查询 Zero Trust 域名清单
    ok_zt, zt_res = mgr.get_zt_domains()
    if not ok_zt:
        print(c_yellow(f"⚠️  警告: 获取 Zero Trust 域名清单失败: {zt_res}"))
        zt_domains_set = set()
    else:
        zt_domains_set = set(d.lower().strip() for d in zt_res.get('domains', []))

    # 3. 查询 Cloudflare 中所有 A 记录 (支持 per_page=100)
    cf_dns_map = {}
    ok_z, zones = mgr.cf_request('GET', '/zones?per_page=50')
    if not ok_z:
        print(c_red(f"❌ 无法从 Cloudflare 获取域名托管区域 (Zones): {zones}"))
        print(c_yellow("请检查 API Token 权限 (需要 Zone.DNS 读写权限) 或检查是否有 IP 访问限制！"))
        return 1

    if zones:
        for z in zones:
            zid = z.get('id')
            ok_r, recs = mgr.cf_request('GET', f'/zones/{zid}/dns_records?type=A&per_page=100')
            if not ok_r:
                print(c_yellow(f"⚠️  获取 Zone [{z.get('name')}] DNS 记录失败: {recs}"))
            elif isinstance(recs, list):
                for r in recs:
                    d_name = r.get('name', '').lower().strip()
                    cf_dns_map[d_name] = {
                        "content": r.get('content', ''),
                        "proxied": r.get('proxied', False)
                    }

    listening_procs = get_listening_processes()

    print(f"\n{c_bold('aaPanel 站点域名与 Cloudflare 状态清单:')}")
    col_w = [4, 25, 4, 12, 22, 10, 8]
    line_len = sum(col_w) + (len(col_w) - 1) * 2

    header_line = "  ".join([
        pad_visible("ID", col_w[0]),
        pad_visible("域名", col_w[1]),
        pad_visible("状态", col_w[2], align='center'),
        pad_visible("反代目标", col_w[3]),
        pad_visible("反代进程", col_w[4]),
        pad_visible("Zero Trust", col_w[5], align='center'),
        pad_visible("小橙云", col_w[6])
    ])

    print("-" * line_len)
    print(c_bold(header_line))
    print("-" * line_len)

    for s in sites:
        sid = s.get('id')
        primary_name = s.get('name', '').strip()
        all_doms = [primary_name]
        for extra in site_domains_map.get(sid, []):
            if extra.lower() != primary_name.lower():
                all_doms.append(extra)

        site_status_txt = c_green("✅") if str(s.get('status')) == '1' else c_red("❌")

        for idx, dom in enumerate(all_doms):
            dom_lower = dom.lower()

            # 反向代理信息 (若别名域名未单独配置代理，回退使用主站点反代配置)
            proxy_val = proxies_map.get(dom_lower, "") or proxies_map.get(primary_name.lower(), "")
            if proxy_val:
                clean_p = proxy_val.replace('http://', '').replace('https://', '').rstrip('/')
                if clean_p.startswith('127.0.0.1:'):
                    proxy_display = c_blue(':' + clean_p.split('127.0.0.1:')[1])
                elif clean_p.startswith('localhost:'):
                    proxy_display = c_blue(':' + clean_p.split('localhost:')[1])
                elif clean_p in ['127.0.0.1', 'localhost']:
                    proxy_display = c_blue(':80')
                else:
                    if len(clean_p) > col_w[3]:
                        clean_p = clean_p[:col_w[3] - 2] + '..'
                    proxy_display = c_blue(clean_p)
            else:
                proxy_display = "-"

            # 反代端口运行进程信息
            target_type, port_or_host = extract_proxy_port(proxy_val, current_ip)
            if target_type == 'LOCAL':
                if port_or_host in listening_procs:
                    proc_info = listening_procs[port_or_host]
                    if visible_len(proc_info) > col_w[4]:
                        proc_info = proc_info[:col_w[4] - 2] + '..'
                    proc_display = c_green(proc_info)
                else:
                    proc_display = c_red("🔴 未监听")
            elif target_type == 'EXTERNAL':
                proc_display = c_blue("🌐 外部目标")
            else:
                proc_display = "-"

            is_zt = dom_lower in zt_domains_set
            zt_txt = c_green("🔒") if is_zt else c_yellow("⚪")

            dns_info = cf_dns_map.get(dom_lower)
            if dns_info:
                proxy_txt = c_orange("开启") if dns_info['proxied'] else "仅DNS"
            else:
                proxy_txt = "-"

            site_id_str = str(sid) if idx == 0 else ""
            status_col = site_status_txt if idx == 0 else ""

            row_str = "  ".join([
                pad_visible(site_id_str, col_w[0]),
                pad_visible(dom, col_w[1]),
                pad_visible(status_col, col_w[2], align='center'),
                pad_visible(proxy_display, col_w[3]),
                pad_visible(proc_display, col_w[4]),
                pad_visible(zt_txt, col_w[5], align='center'),
                pad_visible(proxy_txt, col_w[6])
            ])
            print(row_str)

    print("-" * line_len)
    app_name = mgr.get_app_name()
    print(f"统计: aaPanel 共有 {c_bold(str(len(sites)))} 个站点，Zero Trust ({app_name}) 共有 {c_bold(str(len(zt_domains_set)))} 个保护域名。\n")
    return 0


def cmd_check(args, mgr):
    """检查是否有 Cloudflare 解析到本机，但在 aaPanel 上不存在的域名"""
    if not public:
        print(c_red("错误: 未检测到 aaPanel 核心环境"))
        return 1

    current_ip = mgr.get_server_ip()
    print(c_blue(f"正在扫描 Cloudflare 中解析至本 VPS IP [{current_ip}] 的域名记录..."))

    # 1. 查找 Cloudflare 指向当前 IP 的所有 A 记录
    cf_records_pointing_here = []
    ok_z, zones = mgr.cf_request('GET', '/zones')
    if not ok_z or not zones:
        print(c_red(f"无法从 Cloudflare 获取 Zones 列表: {zones}"))
        return 1

    for z in zones:
        zid = z.get('id')
        ok_r, recs = mgr.cf_request('GET', f'/zones/{zid}/dns_records?type=A&content={current_ip}&per_page=100')
        if ok_r and isinstance(recs, list):
            for r in recs:
                cf_records_pointing_here.append({
                    "name": r.get('name', '').lower().strip(),
                    "proxied": r.get('proxied', False),
                    "zone_id": zid
                })

    # 2. 从 aaPanel 查询所有已登记域名
    panel_domains = set()
    sites = public.M('sites').field('id,name').select() or []
    for s in sites:
        n = s.get('name', '').lower().strip()
        if n: panel_domains.add(n)

    domains_db = public.M('domain').field('id,name').select() or []
    for d in domains_db:
        n = d.get('name', '').lower().strip()
        if n: panel_domains.add(n)

    # 3. 查询 Zero Trust 状态
    ok_zt, zt_res = mgr.get_zt_domains()
    zt_domains_set = set(d.lower().strip() for d in zt_res.get('domains', [])) if ok_zt else set()

    # 4. 比对差异
    missing_in_panel = [cf for cf in cf_records_pointing_here if cf['name'] not in panel_domains]
    cf_all_pointed_names = set(cf['name'] for cf in cf_records_pointing_here)
    missing_in_cf = [d for d in panel_domains if d not in cf_all_pointed_names]

    print("\n" + "=" * 90)
    print(c_bold("🔍 域名一致性核查报告:"))
    print("=" * 90)

    if missing_in_panel:
        print(c_yellow(f"\n⚠️  发现 {len(missing_in_panel)} 个域名已在 Cloudflare 解析到本机，但在 aaPanel 中未创建站点:"))
        print("-" * 90)
        c_w = [30, 20, 20]
        print(c_bold("  " + "  ".join([
            pad_visible("域名 (Domain)", c_w[0]),
            pad_visible("Zero Trust 状态", c_w[1]),
            pad_visible("小橙云代理", c_w[2])
        ])))
        print("-" * 90)
        for item in missing_in_panel:
            dname = item['name']
            in_zt = dname in zt_domains_set
            zt_txt = c_green("🔒 已保护") if in_zt else c_yellow("⚪ 未保护")
            proxy_txt = c_orange("☁️ 开启 (Proxied)") if item['proxied'] else "☁️ 仅DNS"
            row_str = "  " + "  ".join([
                pad_visible(dname, c_w[0]),
                pad_visible(zt_txt, c_w[1]),
                pad_visible(proxy_txt, c_w[2])
            ])
            print(row_str)
        print("-" * 90)
        print(c_yellow("建议: 如需在当前 VPS 创建以上站点，可执行:"))
        for item in missing_in_panel:
            print(f"  {c_blue('bt-cf add ' + item['name'])}")
    else:
        print(c_green("\n✅ 没有发现未在 aaPanel 登记的孤立 Cloudflare 域名。所有指向本机的解析均已在面板建立。"))

    if missing_in_cf:
        print(c_yellow(f"\n⚠️  发现 {len(missing_in_cf)} 个 aaPanel 域名未在 Cloudflare 发现指向当前 IP 的 A 记录:"))
        for d in missing_in_cf:
            print(f"  - {d}")
        print(c_yellow("提示: 若这些域名使用其他 DNS 服务商或仅用于内网，可忽略此提示。"))

    print("\n" + "=" * 90)
    print(f"核查总结: Cloudflare 解析到当前 IP ({current_ip}) 的域名共 {len(cf_records_pointing_here)} 个，aaPanel 已登记 {len(panel_domains)} 个。")
    print("=" * 90 + "\n")
    return 0


def cmd_add(args, mgr):
    """添加站点并联动同步 Cloudflare DNS 与 Zero Trust"""
    domain = args.domain.strip().lower()
    if not domain or not re.match(r"^([\w\-\*]{1,100}\.){1,24}([\w\-]{1,24}|[\w\-]{1,24}\.[\w\-]{1,24})$", domain):
        print(c_red(f"错误: 域名格式不正确 [{domain}]"))
        return 1

    current_ip = mgr.get_server_ip()
    is_proxied = not args.no_proxy
    is_zt = not args.no_zt
    site_path = args.path or f"/www/wwwroot/{domain}"

    # 判断反向代理端口 / 目标
    proxy_target = getattr(args, 'proxy_port', None) or getattr(args, 'proxy_site', None)
    raw_port = str(getattr(args, 'port', '') or '').strip()
    if raw_port and raw_port not in ['80', ''] and not proxy_target:
        proxy_target = raw_port
        print(c_yellow(f"提示: 检测到端口参数 [--port {raw_port}]，自动将其作为反向代理目标端口。"))

    listen_port = str(getattr(args, 'listen_port', 80) or 80)

    print(c_bold(f"\n=== 开始创建与配置站点: {c_blue(domain)} ==="))
    print(f"目标 VPS IP:   {c_blue(current_ip)}")
    if proxy_target:
        print(f"反向代理目标:  {c_blue(str(proxy_target))}")
    print(f"小橙云代理:    {c_orange('开启 (Proxied)') if is_proxied else '关闭 (仅普通DNS)'}")
    print(f"Zero Trust:    {c_green('加入 APP 保护') if is_zt else '不加入'}")
    print(f"站点根目录:    {site_path}")

    # 1. aaPanel 站点创建与配置
    if not args.skip_panel:
        if not panelSite or not public:
            print(c_red("错误: 未检测到 aaPanel 环境，无法创建本地站点 (可通过 --skip-panel 仅配置 Cloudflare)"))
            return 1

        existing = public.M('sites').where('name=?', (domain,)).count()
        if existing:
            print(c_yellow(f"\n[1/3] 提示: aaPanel 中已存在名为 [{domain}] 的站点，跳过建站步骤。"))
        else:
            print(f"\n[1/3] 正在 aaPanel 中创建网站 [{domain}] ...")
            try:
                get = public.dict_obj()
                get.webname = json.dumps({'domain': domain, 'domainlist': [], 'count': 0})
                get.path = site_path
                get.port = listen_port
                get.version = '00'  # 纯静态 / 反向代理默认配置
                get.ps = domain
                get.ftp = False
                get.sql = False

                ps = panelSite.panelSite()
                res = ps.AddSite(get)
                if res.get('siteStatus'):
                    print(c_green(f"  ✅ aaPanel 站点创建成功！(ID: {res.get('siteId')})"))
                else:
                    msg = res.get('msg', '未知错误')
                    print(c_red(f"  ❌ aaPanel 站点创建失败: {msg}"))
                    return 1
            except Exception as e:
                print(c_red(f"  ❌ aaPanel 创建站点异常: {str(e)}"))
                return 1

        # 1.1 配置反向代理
        if proxy_target:
            ok_px, px_msg = setup_site_proxy(domain, proxy_target)
            if ok_px:
                print(c_green(f"  ✅ 已配置反向代理: / -> {px_msg}"))
            else:
                print(c_yellow(f"  ⚠️  反向代理配置失败: {px_msg}"))

        # 1.2 自动配置 SSL (默认开启)
        if not getattr(args, 'no_ssl', False):
            ok_ssl, ssl_msg = configure_site_ssl(domain)
            if ok_ssl:
                print(c_green(f"  ✅ {ssl_msg}"))
            else:
                print(c_yellow(f"  ⚠️  SSL 配置未完成: {ssl_msg} (站点仍可在 HTTP 80 正常访问)"))
    else:
        print("\n[1/3] 已指定 --skip-panel，跳过本地 aaPanel 站点创建。")

    # 2. Cloudflare DNS 同步
    if not args.skip_cf:
        print(f"\n[2/3] 正在向 Cloudflare 同步 DNS A 记录 ({domain} -> {current_ip}, Proxied: {is_proxied}) ...")
        ok_z, zone = mgr.find_matching_zone(domain)
        if not ok_z or not zone:
            print(c_red(f"  ❌ 未在 Cloudflare 中找到匹配的 Zone: {zone}"))
        else:
            zid = zone['id']
            ok_q, records = mgr.cf_request('GET', f"/zones/{zid}/dns_records?name={domain}&type=A")
            dns_payload = {
                "type": "A",
                "name": domain,
                "content": current_ip,
                "ttl": 1 if is_proxied else 300,
                "proxied": is_proxied
            }

            if ok_q and isinstance(records, list) and len(records) > 0:
                rec_id = records[0]['id']
                ok_u, res_u = mgr.cf_request('PUT', f"/zones/{zid}/dns_records/{rec_id}", dns_payload)
                if ok_u:
                    print(c_green(f"  ✅ DNS A 记录已更新！(目标: {current_ip}, Proxied: {is_proxied})"))
                else:
                    print(c_red(f"  ❌ DNS A 记录更新失败: {res_u}"))
            else:
                ok_c, res_c = mgr.cf_request('POST', f"/zones/{zid}/dns_records", dns_payload)
                if ok_c:
                    print(c_green(f"  ✅ DNS A 记录创建成功！(目标: {current_ip}, Proxied: {is_proxied})"))
                else:
                    print(c_red(f"  ❌ DNS A 记录创建失败: {res_c}"))

        # 3. Zero Trust 同步
        if is_zt:
            app_name = mgr.get_app_name()
            print(f"\n[3/3] 正在将 [{domain}] 添加到 Zero Trust ({app_name}) ...")
            ok_zt, msg_zt = mgr.toggle_domain_zt(domain, action='add')
            if ok_zt:
                print(c_green(f"  ✅ {msg_zt}"))
            else:
                print(c_red(f"  ❌ 添加到 Zero Trust 失败: {msg_zt}"))
        else:
            print("\n[3/3] 参数指定不加入 Zero Trust，跳过。")
    else:
        print("\n[2/3] 已指定 --skip-cf，跳过 Cloudflare 联动。")

    print(c_bold(f"\n🎉 站点 [{domain}] 配置流程全部完成！\n"))
    return 0


def cmd_toggle_zt(args, mgr):
    """一键开启或关闭指定域名的 Zero Trust 保护"""
    domain = args.domain.strip().lower()
    action = args.action.lower() if args.action else 'toggle'

    label = "开启" if action == 'on' else ("关闭" if action == 'off' else "切换")
    print(c_blue(f"正在为 [{domain}] {label} Cloudflare Zero Trust 保护..."))

    ok, msg = mgr.toggle_domain_zt(domain, action)
    if ok:
        print(c_green(f"✅ {msg}"))
    else:
        print(c_red(f"❌ {msg}"))
    return 0 if ok else 1


def cmd_del(args, mgr):
    """删除本地站点并可选同步清理 Cloudflare 记录"""
    domain = args.domain.strip().lower()
    print(c_bold(f"\n=== 删除站点/域名: {c_red(domain)} ==="))

    if public and panelSite:
        site = public.M('sites').where('name=?', (domain,)).find()
        if site:
            print(f"正在从 aaPanel 中删除站点 [{domain}] (ID: {site.get('id')}) ...")
            try:
                get = public.dict_obj()
                get.id = site.get('id')
                get.webname = domain
                del_res = panelSite.panelSite().DeleteSite(get)
                if del_res.get('status'):
                    print(c_green("  ✅ aaPanel 站点已删除"))
                else:
                    print(c_red(f"  ❌ 删除站点失败: {del_res.get('msg')}"))
            except Exception as e:
                print(c_red(f"  ❌ 删除本地站点异常: {e}"))
        else:
            print(c_yellow(f"  提示: aaPanel 中未找到名为 [{domain}] 的站点。"))

    if not args.keep_cf:
        print(f"正在从 Cloudflare Zero Trust 中移出 [{domain}] ...")
        mgr.toggle_domain_zt(domain, action='off')

        print(f"正在从 Cloudflare DNS 中删除 [{domain}] ...")
        ok_z, zone = mgr.find_matching_zone(domain)
        if ok_z and zone:
            zid = zone['id']
            ok_r, recs = mgr.cf_request('GET', f"/zones/{zid}/dns_records?name={domain}&type=A")
            if ok_r and isinstance(recs, list) and recs:
                for r in recs:
                    mgr.cf_request('DELETE', f"/zones/{zid}/dns_records/{r['id']}")
                print(c_green("  ✅ Cloudflare DNS A 记录已删除"))
            else:
                print(c_yellow("  提示: Cloudflare 中未找到该域名的 A 记录"))
    else:
        print(c_yellow("  提示: 已保留 Cloudflare DNS 与 Zero Trust 配置 (--keep-cf)。"))

    print(c_bold("\n操作已完成。\n"))
    return 0


