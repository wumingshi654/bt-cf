def visible_len(s):
    """计算字符串在终端中的实际可见字符宽度 (去除 ANSI 转义码，计算双宽字符)"""
    clean = re.sub(r'\033\[[0-9;]*m', '', s)
    width = 0
    for ch in clean:
        if ord(ch) > 0x2e80 or ch in ['🔒', '⚪', '☁', '️', '⚠️', '✅', '❌', '🔴', '🌐']:
            if ch != '️':  # 变体选择符不占宽度
                width += 2
        else:
            width += 1
    return width


def pad_visible(s, target_width, align='left'):
    """按终端可见宽度进行对齐填充"""
    vlen = visible_len(s)
    padding = max(0, target_width - vlen)
    if align == 'right':
        return ' ' * padding + s
    elif align == 'center':
        left_pad = padding // 2
        right_pad = padding - left_pad
        return ' ' * left_pad + s + ' ' * right_pad
    else:
        return s + ' ' * padding


# =====================================================================
# 动态 VPS IP 自动检测机制 (多 VPS 支持)
# =====================================================================

def detect_vps_ip():
    """
    自动检测当前 VPS 的外网公网 IPv4 地址。
    按优先级排查:
    1. aaPanel 的 iplist.txt 缓存
    2. 本机网络接口上的全局公网 IPv4 地址
    3. 多节点外部无代理 HTTP 查询兜底
    """
    # 1. 检查 aaPanel 已存的公网 IP 记录
    iplist_file = '/www/server/panel/data/iplist.txt'
    if os.path.exists(iplist_file):
        try:
            with open(iplist_file, 'r') as f:
                ip = f.read().strip()
                if re.match(r'^([0-9]{1,3}\.){3}[0-9]{1,3}$', ip) and not ip.startswith('127.'):
                    return ip
        except Exception:
            pass

    # 2. 检查本机网络接口全局 IP (排除私有保留网段)
    try:
        out = subprocess.check_output(['ip', '-4', 'addr', 'show', 'scope', 'global'], timeout=3).decode('utf-8')
        for match in re.finditer(r'inet\s+([0-9.]+)/\d+', out):
            ip = match.group(1)
            if not (ip.startswith('10.') or ip.startswith('172.') or ip.startswith('192.168.') or ip.startswith('127.')):
                return ip
    except Exception:
        pass

    # 3. 外部 API 查询兜底 (直连无代理)
    services = ['https://api.ipify.org', 'https://ifconfig.me/ip', 'https://icanhazip.com']
    for url in services:
        try:
            cmd = ['curl', '-4', '-s', '--connect-timeout', '3', '--noproxy', '*', url]
            ip = subprocess.check_output(cmd, timeout=4).decode('utf-8').strip()
            if re.match(r'^([0-9]{1,3}\.){3}[0-9]{1,3}$', ip) and not ip.startswith('127.'):
                return ip
        except Exception:
            continue

    return '127.0.0.1'


