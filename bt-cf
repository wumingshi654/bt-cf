def cmd_update(args, mgr):
    """从 GitHub 远程仓库拉取并更新 bt-cf 到最新版本"""
    target_bin = "/usr/local/bin/bt-cf"
    curr_script = os.path.realpath(os.path.abspath(__file__))

    # 检查写入权限
    if os.geteuid() != 0 and not os.access(target_bin, os.W_OK):
        print(c_red("错误: 更新 bt-cf 需要 root 权限，请使用 sudo bt-cf update 或切换至 root 执行！"))
        return 1

    print(c_blue("正在从 GitHub 检查并获取最新版本的 bt-cf ..."))

    # 1. 尝试寻找本机已有的 git 源码仓库目录 (包含当前运行路径及常用路径)
    candidate_repos = []
    for p in [os.path.dirname(curr_script), "/root/project/bt-cf", "/root/bt-cf"]:
        if p and p not in candidate_repos and os.path.isdir(os.path.join(p, '.git')):
            candidate_repos.append(p)

    if not getattr(args, 'url', None):
        for r_dir in candidate_repos:
            try:
                diff_chk = subprocess.run(['git', '-C', r_dir, 'status', '--porcelain'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=5)
                if diff_chk.returncode == 0 and not diff_chk.stdout.strip():
                    res = subprocess.run(['git', '-C', r_dir, 'pull'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=12)
                    if res.returncode == 0:
                        src_file = os.path.join(r_dir, 'bt-cf')
                        if os.path.exists(src_file):
                            import shutil
                            shutil.copyfile(src_file, target_bin)
                            os.chmod(target_bin, 0o755)
                            print(c_green(f"  ✅ Git 源码仓库已同步拉取: {r_dir}"))
                            print(c_green(f"  ✅ 系统命令已更新: {target_bin}"))
                            print(c_green("\n🎉 bt-cf 已成功更新至最新版本！可通过 bt-cf --help 确认。\n"))
                            return 0
            except Exception:
                pass

    # 2. 尝试从 Raw URL 下载 (适用于公开仓库一键部署模式，或带 Token 私有访问)
    raw_urls = [
        "https://raw.githubusercontent.com/wumingshi654/bt-cf/main/bt-cf",
        "https://cdn.jsdelivr.net/gh/wumingshi654/bt-cf@main/bt-cf",
        "https://fastly.jsdelivr.net/gh/wumingshi654/bt-cf@main/bt-cf"
    ]
    if getattr(args, 'url', None):
        raw_urls.insert(0, args.url)

    gh_token = os.environ.get('GITHUB_TOKEN') or os.environ.get('GH_TOKEN')
    if not gh_token and os.path.exists('/etc/bt-cf/config.json'):
        try:
            with open('/etc/bt-cf/config.json', 'r') as f:
                cfg = json.load(f)
                gh_token = cfg.get('github_token')
        except Exception:
            pass

    tmp_file = "/tmp/bt-cf.update.tmp"
    downloaded = False
    download_err = ""

    for url in raw_urls:
        try:
            cmd = ['curl', '-fsSL', '--connect-timeout', '10']
            if gh_token:
                cmd.extend(['-H', f'Authorization: token {gh_token}'])
            cmd.extend(['-o', tmp_file, url])
            res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=15)
            if res.returncode == 0 and os.path.exists(tmp_file) and os.path.getsize(tmp_file) > 10240:
                with open(tmp_file, 'r', encoding='utf-8', errors='ignore') as f:
                    content = f.read()
                if '#!/usr/bin/env python3' in content and 'aaPanel' in content:
                    compile(content, tmp_file, 'exec')
                    downloaded = True
                    break
        except Exception as e:
            download_err = str(e)
            continue

    # 3. 若 Raw URL 下载失败 (例如私有仓库未公开)，尝试通过 Git SSH 浅克隆回退获取
    if not downloaded and not getattr(args, 'url', None):
        ssh_remotes = ["git@github.com:wumingshi654/bt-cf.git"]
        tmp_git_dir = "/tmp/bt-cf-git-update"
        for s_remote in ssh_remotes:
            try:
                if os.path.exists(tmp_git_dir):
                    import shutil
                    shutil.rmtree(tmp_git_dir, ignore_errors=True)
                res = subprocess.run(
                    ['git', 'clone', '--depth=1', '--quiet', s_remote, tmp_git_dir],
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=15
                )
                if res.returncode == 0:
                    cloned_bin = os.path.join(tmp_git_dir, 'bt-cf')
                    if os.path.exists(cloned_bin) and os.path.getsize(cloned_bin) > 10240:
                        import shutil
                        shutil.copyfile(cloned_bin, tmp_file)
                        shutil.rmtree(tmp_git_dir, ignore_errors=True)
                        downloaded = True
                        break
            except Exception:
                continue

    if not downloaded:
        print(c_red("❌ 下载或校验最新 bt-cf 失败！"))
        print(c_yellow("排查建议:"))
        print(c_yellow("  1. 请检查网络连接能否访问 GitHub。"))
        print(c_yellow("  2. 若 GitHub 仓库为 Private (私有仓库)，请在 GitHub 仓库设置中将其设为 Public。"))
        if download_err:
            print(c_yellow(f"  3. 错误详情: {download_err}"))
        return 1

    try:
        import shutil
        os.chmod(tmp_file, 0o755)

        # 1. 更新 target_bin (/usr/local/bin/bt-cf)
        shutil.move(tmp_file, target_bin)
        os.chmod(target_bin, 0o755)
        print(c_green(f"  ✅ 系统命令已更新: {target_bin}"))

        # 2. 如果当前执行脚本路径与 target_bin 不同且可写，也同步一份
        if curr_script != target_bin and os.path.exists(curr_script):
            try:
                shutil.copyfile(target_bin, curr_script)
                os.chmod(curr_script, 0o755)
                print(c_green(f"  ✅ 本地脚本已同步: {curr_script}"))
            except Exception:
                pass

        print(c_green("\n🎉 bt-cf 已成功更新至最新版本！可通过 bt-cf --help 确认命令。\n"))
        return 0
    except Exception as e:
        print(c_red(f"❌ 替换目标文件失败: {e}"))
        return 1


# =====================================================================
# 主入口
# =====================================================================

def main():
    parser = argparse.ArgumentParser(
        prog="bt-cf",
        description="aaPanel & Cloudflare DNS / Zero Trust 联动管理 CLI 工具",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例:
  bt-cf add test.example.com -p 8123         # 建站 + 反代到8123 + 默认SSL + 开启小橙云 + 加ZT
  bt-cf add api.example.com --no-zt          # 开启小橙云，但不加入 Zero Trust
  bt-cf add direct.example.com --no-proxy    # 仅普通DNS解析(直连)，加入 Zero Trust
  bt-cf list                                 # 列出所有域名、反代端口、Zero Trust及DNS状态
  bt-cf proxy 26 8123                        # 通过站点 ID 修改反代端口为 8123
  bt-cf proxy app.example.com 8123           # 通过域名修改反代端口为 8123
  bt-cf check                                # 检查解析到本机但 aaPanel 未添加的孤立域名
  bt-cf toggle-zt test.example.com           # 一键翻转 Zero Trust 状态
  bt-cf del test.example.com                 # 删除站点并同步清理 CF 记录
  bt-cf update                               # 一键从 GitHub 检查并升级到最新版本
  bt-cf config --token <Token> --app APP     # 配置或修改 Cloudflare 凭据
  bt-cf status                               # 检查 Cloudflare API 与配置状态
        """
    )
    # 全局参数
    parser.add_argument("--ip", help="指定 VPS 公网 IP (默认自动检测本机外网 IP)")

    subparsers = parser.add_subparsers(dest="subcommand", help="可用命令")

    # 1. add
    p_add = subparsers.add_parser("add", help="添加新域名/站点，同步 Cloudflare DNS 与 Zero Trust")
    p_add.add_argument("domain", help="要添加的完整域名 (如 demo.example.com)")
    p_add.add_argument("--proxy-port", "-p", help="反向代理目标端口 (例如: 8123，将反代至 http://127.0.0.1:8123)")
    p_add.add_argument("--proxy-site", help="反向代理完整目标地址 (例如: http://127.0.0.1:8123)")
    p_add.add_argument("--port", help="指定端口 (若传入如 8123，自动作为反代端口配置)")
    p_add.add_argument("--listen-port", type=int, default=80, help="Nginx 监听端口 (默认: 80)")
    p_add.add_argument("--no-ssl", action="store_true", help="不自动配置 SSL (默认会自动配置并启用 443 端口)")
    p_add.add_argument("--proxy", dest="no_proxy", action="store_false", default=False, help="开启 Cloudflare 小橙云代理 (默认开启)")
    p_add.add_argument("--no-proxy", dest="no_proxy", action="store_true", help="关闭小橙云代理 (仅普通 DNS 解析)")
    p_add.add_argument("--zt", dest="no_zt", action="store_false", default=False, help="加入 Cloudflare Zero Trust (默认加入)")
    p_add.add_argument("--no-zt", dest="no_zt", action="store_true", help="不加入 Zero Trust")
    p_add.add_argument("--path", help="站点根目录 (默认: /www/wwwroot/<域名>)")
    p_add.add_argument("--skip-panel", action="store_true", help="仅配置 Cloudflare，跳过创建本地 aaPanel 站点")
    p_add.add_argument("--skip-cf", action="store_true", help="仅创建本地 aaPanel 站点，跳过 Cloudflare 同步")

    # 2. list
    subparsers.add_parser("list", help="列出 aaPanel 所有域名及其 Zero Trust 与 DNS 状态")

    # 3. check
    subparsers.add_parser("check", help="检查 Cloudflare 上解析到本机的域名，但在 aaPanel 上不存在的记录")

    # 4. toggle-zt
    p_zt = subparsers.add_parser("toggle-zt", help="切换某个域名的 Zero Trust 保护状态")
    p_zt.add_argument("domain", help="要切换保护的域名")
    p_zt.add_argument("action", nargs="?", choices=["on", "off"], help="强制开启 (on) 或强制关闭 (off)，留空则自动切换")

    # 5. del
    p_del = subparsers.add_parser("del", help="删除站点，并可选同步删除 Cloudflare 记录")
    p_del.add_argument("domain", help="要删除的域名")
    p_del.add_argument("--keep-cf", action="store_true", help="仅从 aaPanel 删除站点，保留 Cloudflare 记录")

    # 6. config
    p_cfg = subparsers.add_parser("config", help="查看或更新 Cloudflare 凭证与配置")
    p_cfg.add_argument("--token", help="Cloudflare API Token")
    p_cfg.add_argument("--app", help="Zero Trust 应用程序名称 (如 APP)")
    p_cfg.add_argument("--zone", help="默认托管 Zone 域名 (如 example.com)")

    # 7. status
    subparsers.add_parser("status", help="检查 Cloudflare API 凭证与连接状态")

    # 8. proxy
    p_proxy = subparsers.add_parser("proxy", help="更改指定站点 (支持站点 ID 或域名) 的反向代理端口/目标")
    p_proxy.add_argument("target", help="aaPanel 站点 ID (如 26) 或域名 (如 app.example.com)")
    p_proxy.add_argument("port", help="新的反代端口或目标 URL (如 8123 或 http://127.0.0.1:8123)")

    # 9. update
    p_up = subparsers.add_parser("update", help="从 GitHub 仓库一键检查并更新 bt-cf 到最新版本")
    p_up.add_argument("--url", help="自定义远程更新脚本的 URL 地址")

    args = parser.parse_args()

    if not args.subcommand:
        parser.print_help()
        sys.exit(0)

    mgr = CloudflareManager(override_ip=args.ip)

    dispatch = {
        "config": cmd_config,
        "status": cmd_status,
        "list": cmd_list,
        "check": cmd_check,
        "add": cmd_add,
        "toggle-zt": cmd_toggle_zt,
        "del": cmd_del,
        "proxy": cmd_proxy,
        "update": cmd_update
    }

    func = dispatch.get(args.subcommand)
    if func:
        code = func(args, mgr)
        sys.exit(code or 0)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
