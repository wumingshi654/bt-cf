def extract_proxy_from_nginx_conf(filepath):
    """从 Nginx 配置文件中解析真实的 proxy_pass 目标"""
    if not os.path.exists(filepath):
        return None
    try:
        with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
            content = f.read()

        # 过滤注释行
        lines = [line for line in content.splitlines() if not line.strip().startswith('#')]
        cleaned = '\n'.join(lines)

        # 优先查找根代理 location / 中的 proxy_pass
        root_loc = re.search(r'location\s+(?:(?:\^~|=)\s+)?/\s*\{([^}]+)\}', cleaned)
        if root_loc:
            m = re.search(r'proxy_pass\s+([^;\s]+);', root_loc.group(1))
            if m:
                target = m.group(1).strip()
                if not target.startswith('$'):
                    return target.rstrip('/')

        # 兜底查找任意有效 proxy_pass
        matches = re.findall(r'proxy_pass\s+([^;\s]+);', cleaned)
        for m in matches:
            target = m.strip()
            if target and not target.startswith('$'):
                return target.rstrip('/')
    except Exception:
        pass
    return None


def extract_proxy_from_apache_conf(filepath):
    """从 Apache 配置文件中解析 ProxyPass 目标"""
    if not os.path.exists(filepath):
        return None
    try:
        with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
            content = f.read()
        lines = [line.strip() for line in content.splitlines() if not line.strip().startswith('#')]
        for line in lines:
            m = re.search(r'ProxyPass\s+(?:/\s+)?([^\s;]+)', line)
            if m:
                target = m.group(1).strip()
                if not target.startswith('!'):
                    return target.rstrip('/')
    except Exception:
        pass
    return None


def extract_proxy_from_ols_conf(filepath):
    """从 OpenLiteSpeed 配置文件中解析 address 目标"""
    if not os.path.exists(filepath):
        return None
    try:
        with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
            content = f.read()
        lines = [line.strip() for line in content.splitlines() if not line.strip().startswith('#')]
        for line in lines:
            m = re.search(r'address\s+([^\s;]+)', line)
            if m:
                return m.group(1).strip().rstrip('/')
    except Exception:
        pass
    return None


def get_site_proxies():
    """
    读取 aaPanel 中所有站点的反向代理配置映射 {sitename: proxysite}
    优先直接从 Web 服务器 (Nginx / Apache / OpenLiteSpeed) 的实际配置文件中读取，
    确保与运行时的真实反代目标保持 100% 一致；若配置文件缺失则回退到 proxyfile.json。
    同时，若检测到 proxyfile.json 与真实配置存在偏差，自动同步修正 proxyfile.json。
    """
    proxy_map = {}
    proxyfile = '/www/server/panel/data/proxyfile.json'

    # 1. 优先读取 Nginx 实际反代配置 (/www/server/panel/vhost/nginx/proxy/{sitename}/*.conf)
    nginx_proxy_base = '/www/server/panel/vhost/nginx/proxy'
    if os.path.isdir(nginx_proxy_base):
        try:
            for sname in os.listdir(nginx_proxy_base):
                sdir = os.path.join(nginx_proxy_base, sname)
                if os.path.isdir(sdir):
                    confs = sorted([c for c in os.listdir(sdir) if c.endswith('.conf')])
                    for conf in confs:
                        target = extract_proxy_from_nginx_conf(os.path.join(sdir, conf))
                        if target:
                            proxy_map[sname.lower()] = target
                            break
        except Exception:
            pass

    # 2. 检查 Nginx 主虚拟主机配置文件中直接写入的 proxy_pass
    nginx_vhost_base = '/www/server/panel/vhost/nginx'
    if os.path.isdir(nginx_vhost_base):
        try:
            for conf_file in glob.glob(os.path.join(nginx_vhost_base, '*.conf')):
                sname = os.path.basename(conf_file)[:-5].lower()
                if sname not in proxy_map:
                    target = extract_proxy_from_nginx_conf(conf_file)
                    if target:
                        proxy_map[sname] = target
        except Exception:
            pass

    # 3. 检查 Apache 实际反代配置
    apache_proxy_base = '/www/server/panel/vhost/apache/proxy'
    if os.path.isdir(apache_proxy_base):
        try:
            for sname in os.listdir(apache_proxy_base):
                sdir = os.path.join(apache_proxy_base, sname)
                if os.path.isdir(sdir) and sname.lower() not in proxy_map:
                    confs = sorted([c for c in os.listdir(sdir) if c.endswith('.conf')])
                    for conf in confs:
                        target = extract_proxy_from_apache_conf(os.path.join(sdir, conf))
                        if target:
                            proxy_map[sname.lower()] = target
                            break
        except Exception:
            pass

    # 4. 检查 OpenLiteSpeed 实际反代配置
    ols_proxy_base = '/www/server/panel/vhost/openlitespeed/proxy'
    if os.path.isdir(ols_proxy_base):
        try:
            for sname in os.listdir(ols_proxy_base):
                sdir = os.path.join(ols_proxy_base, sname)
                if os.path.isdir(sdir) and sname.lower() not in proxy_map:
                    confs = sorted([c for c in os.listdir(sdir) if c.endswith('.conf')])
                    for conf in confs:
                        target = extract_proxy_from_ols_conf(os.path.join(sdir, conf))
                        if target:
                            proxy_map[sname.lower()] = target
                            break
        except Exception:
            pass

    # 5. 回退 / 兜底读取 proxyfile.json，并自动校准同步
    proxyfile_data = []
    need_sync_proxyfile = False
    if os.path.exists(proxyfile):
        try:
            with open(proxyfile, 'r', encoding='utf-8') as f:
                proxyfile_data = json.load(f)
            if isinstance(proxyfile_data, list):
                for item in proxyfile_data:
                    sname = item.get('sitename', '').strip().lower()
                    psite = item.get('proxysite', '').strip()
                    if not sname:
                        continue
                    if sname in proxy_map:
                        # 检查 proxyfile.json 是否有旧数据，如果有差异则标记同步
                        real_site = proxy_map[sname]
                        if psite.rstrip('/') != real_site.rstrip('/'):
                            item['proxysite'] = real_site
                            need_sync_proxyfile = True
                    else:
                        if psite and int(item.get('type', 1)) == 1:
                            proxy_map[sname] = psite.rstrip('/')
        except Exception:
            pass

    # 6. 如果 proxyfile.json 存在过时数据，自动回写保持面板状态一致
    if need_sync_proxyfile and proxyfile_data:
        try:
            with open(proxyfile, 'w', encoding='utf-8') as f:
                json.dump(proxyfile_data, f, ensure_ascii=False, indent=2)
        except Exception:
            pass

    return proxy_map


def get_docker_port_map():
    """读取 Docker 容器端口映射 {port_str: container_name}"""
    d_map = {}
    try:
        out = subprocess.check_output(['docker', 'ps', '--format', '{{.Names}}\t{{.Ports}}'], timeout=2).decode('utf-8', errors='ignore')
        for line in out.splitlines():
            line = line.strip()
            if not line or '\t' not in line:
                continue
            name, ports = line.split('\t', 1)
            for m in re.finditer(r':(\d+)(?:-(\d+))?->', ports):
                p1 = int(m.group(1))
                p2 = int(m.group(2)) if m.group(2) else p1
                for p in range(p1, p2 + 1):
                    d_map[str(p)] = name
    except Exception:
        pass
    return d_map


def get_listening_processes():
    """获取本机当前正在监听的 TCP 端口与对应进程映射 {port_str: process_description}"""
    port_map = {}
    docker_map = get_docker_port_map()

    # 1. 优先尝试使用 ss -tlnp
    try:
        out = subprocess.check_output(['ss', '-tlnp'], timeout=3).decode('utf-8', errors='ignore')
        for line in out.splitlines():
            line = line.strip()
            if not line.startswith('LISTEN'):
                continue

            m_port = re.search(r':(\d+)\s+', line)
            if not m_port:
                continue
            port = m_port.group(1)

            m_user = re.search(r'users:\(\(\"([^\"]+)\",pid=(\d+)', line)
            pname = m_user.group(1) if m_user else ''
            pid = m_user.group(2) if m_user else ''

            if port in docker_map:
                c_name = docker_map[port]
                port_map[port] = f"docker:{c_name}"
            elif pname:
                display_name = pname
                if '-linux-' in pname:
                    display_name = pname.split('-linux-')[0]
                elif pname in ['python', 'python3', 'node'] and pid:
                    try:
                        with open(f'/proc/{pid}/cmdline', 'r') as f:
                            args = [a for a in f.read().split('\0') if a]
                            meaningful = [a for a in args[1:] if not a.startswith('-')]
                            if meaningful:
                                script_or_mod = os.path.basename(meaningful[0])
                                display_name = f"{pname}:{script_or_mod}"
                    except Exception:
                        pass
                port_map[port] = f"{display_name}({pid})" if pid else display_name
            else:
                port_map[port] = "running"
    except Exception:
        pass

    # 2. 若 ss 未采集到数据，尝试 lsof 兜底
    if not port_map:
        try:
            out = subprocess.check_output(['lsof', '-iTCP', '-sTCP:LISTEN', '-n', '-P'], timeout=3).decode('utf-8', errors='ignore')
            for line in out.splitlines()[1:]:
                parts = line.split()
                if len(parts) >= 9:
                    cmd_name = parts[0]
                    pid = parts[1]
                    addr = parts[8]
                    if ':' in addr:
                        port = addr.split(':')[-1]
                        if port.isdigit():
                            if port in docker_map:
                                port_map[port] = f"docker:{docker_map[port]}"
                            else:
                                port_map[port] = f"{cmd_name}({pid})"
        except Exception:
            pass

    return port_map


def extract_proxy_port(proxy_val, current_ip=None):
    """
    从反向代理配置中提取目标端口：
    - 返回 ('LOCAL', port_str) 如果是本地端口 (127.0.0.1 / localhost / 0.0.0.0 / 本机IP / 纯端口)
    - 返回 ('EXTERNAL', host_str) 如果是外部目标
    - 返回 (None, None) 如果无法提取或无代理
    """
    if not proxy_val:
        return None, None
    clean = proxy_val.replace('http://', '').replace('https://', '').split('/')[0].strip()
    if not clean:
        return None, None

    if ':' in clean:
        parts = clean.split(':', 1)
        host = parts[0].strip().lower()
        port = parts[1].strip()
        if not port.isdigit():
            return 'EXTERNAL', clean
        if host in ['', '127.0.0.1', 'localhost', '0.0.0.0', '::1']:
            return 'LOCAL', port
        if current_ip and host == current_ip:
            return 'LOCAL', port
        return 'EXTERNAL', clean
    elif clean.isdigit():
        return 'LOCAL', clean
    else:
        return 'EXTERNAL', clean


def normalize_proxy_target(proxy_target):
    """
    标准化反向代理目标：
    支持端口号 (如 8123) 或完整 URL (如 http://127.0.0.1:8123)
    返回 (normalized_url, error_msg)
    """
    target_str = str(proxy_target).strip()
    if not target_str:
        return None, "反向代理目标不能为空"
    if re.match(r'^\d+$', target_str):
        port = int(target_str)
        if not (1 <= port <= 65535):
            return None, f"端口号超出有效范围 (1-65535): {target_str}"
        return f"http://127.0.0.1:{port}", None
    elif target_str.startswith('http://') or target_str.startswith('https://'):
        return target_str.rstrip('/'), None
    else:
        return f"http://{target_str}".rstrip('/'), None


def setup_site_proxy(domain, proxy_target):
    """
    为 aaPanel 站点配置反向代理：
    支持 proxy_target 为端口号 (如 8123) 或完整 URL (如 http://127.0.0.1:8123)
    """
    if not proxy_target:
        return True, None
    if not panelSite or not public:
        return False, "未检测到 aaPanel 核心环境"

    proxysite, err = normalize_proxy_target(proxy_target)
    if err:
        return False, err

    try:
        ps = panelSite.panelSite()
        get = public.dict_obj()
        get.sitename = domain
        get.proxyname = "proxy_" + public.md5(domain)[:5]
        get.proxysite = proxysite
        get.proxydir = "/"
        get.todomain = "$host"
        get.type = 1
        get.cache = 0
        get.subfilter = '[{"sub1": "", "sub2": ""}, {"sub1": "", "sub2": ""}, {"sub1": "", "sub2": ""}]'
        get.advanced = 0
        get.cachetime = 1
        get.nocheck = "1"

        res = ps.CreateProxy(get)
        if isinstance(res, dict) and res.get('status'):
            return True, proxysite
        elif isinstance(res, dict):
            return False, res.get('msg', str(res))
        return True, proxysite
    except Exception as e:
        return False, str(e)


def _replace_nginx_proxy_pass(content, new_target):
    """在 Nginx 代理配置中精准替换根 location / (或首个有效) proxy_pass，保留自定义指令"""
    # 1. 优先替换 location / { ... } 块内的 proxy_pass
    loc_pat = re.compile(r'(location\s+(?:(?:\^~|=)\s+)?/\s*\{[^}]*?proxy_pass\s+)([^;\s]+)(;)', re.DOTALL)
    if loc_pat.search(content):
        return loc_pat.sub(lambda m: f"{m.group(1)}{new_target}{m.group(3)}", content, count=1), True

    # 2. 兜底替换首个非变量 proxy_pass
    any_pat = re.compile(r'(^\s*proxy_pass\s+)(?!\$)([^;\s]+)(;)', re.MULTILINE)
    if any_pat.search(content):
        return any_pat.sub(lambda m: f"{m.group(1)}{new_target}{m.group(3)}", content, count=1), True

    return content, False


def update_site_proxy(domain, proxy_target):
    """
    更新 aaPanel 站点的反向代理目标 (保留原有自定义 Nginx 规则，若站点尚未配置代理则自动创建)：
    返回 (ok, new_proxysite_or_error)
    """
    if not panelSite or not public:
        return False, "未检测到 aaPanel 核心环境"

    proxysite, err = normalize_proxy_target(proxy_target)
    if err:
        return False, err

    updated_any = False
    backups = []

    try:
        # 1. 更新 Nginx 代理配置 (/www/server/panel/vhost/nginx/proxy/{domain}/*.conf)
        nginx_proxy_dir = f"/www/server/panel/vhost/nginx/proxy/{domain}"
        if os.path.isdir(nginx_proxy_dir):
            confs = sorted([c for c in os.listdir(nginx_proxy_dir) if c.endswith('.conf')])
            for conf in confs:
                fpath = os.path.join(nginx_proxy_dir, conf)
                with open(fpath, 'r', encoding='utf-8', errors='ignore') as f:
                    old_content = f.read()
                new_content, replaced = _replace_nginx_proxy_pass(old_content, proxysite)
                if replaced:
                    backups.append((fpath, old_content))
                    with open(fpath, 'w', encoding='utf-8') as f:
                        f.write(new_content)
                    updated_any = True
                    break

        # 2. 若未在 proxy 子目录找到，检查 Nginx 主虚拟主机配置文件
        if not updated_any:
            nginx_vhost = f"/www/server/panel/vhost/nginx/{domain}.conf"
            if os.path.exists(nginx_vhost):
                with open(nginx_vhost, 'r', encoding='utf-8', errors='ignore') as f:
                    old_content = f.read()
                new_content, replaced = _replace_nginx_proxy_pass(old_content, proxysite)
                if replaced:
                    backups.append((nginx_vhost, old_content))
                    with open(nginx_vhost, 'w', encoding='utf-8') as f:
                        f.write(new_content)
                    updated_any = True

        # 3. 同步更新 Apache 代理配置 (若存在)
        apache_proxy_dir = f"/www/server/panel/vhost/apache/proxy/{domain}"
        if os.path.isdir(apache_proxy_dir):
            confs = sorted([c for c in os.listdir(apache_proxy_dir) if c.endswith('.conf')])
            for conf in confs:
                fpath = os.path.join(apache_proxy_dir, conf)
                with open(fpath, 'r', encoding='utf-8', errors='ignore') as f:
                    old_content = f.read()
                new_content = re.sub(
                    r'(ProxyPass(?:Reverse)?\s+/\s+)([^\s;]+)',
                    lambda m: f"{m.group(1)}{proxysite}/",
                    old_content
                )
                if new_content != old_content:
                    backups.append((fpath, old_content))
                    with open(fpath, 'w', encoding='utf-8') as f:
                        f.write(new_content)
                    updated_any = True

        # 4. 同步更新 OpenLiteSpeed 代理配置 (若存在)
        ols_proxy_dir = f"/www/server/panel/vhost/openlitespeed/proxy/{domain}"
        if os.path.isdir(ols_proxy_dir):
            confs = sorted([c for c in os.listdir(ols_proxy_dir) if c.endswith('.conf')])
            for conf in confs:
                fpath = os.path.join(ols_proxy_dir, conf)
                with open(fpath, 'r', encoding='utf-8', errors='ignore') as f:
                    old_content = f.read()
                new_content = re.sub(
                    r'(address\s+)([^\s;]+)',
                    lambda m: f"{m.group(1)}{proxysite}",
                    old_content
                )
                if new_content != old_content:
                    backups.append((fpath, old_content))
                    with open(fpath, 'w', encoding='utf-8') as f:
                        f.write(new_content)
                    updated_any = True

        # 5. 若站点尚未配置过任何反代，直接调用 CreateProxy 创建
        if not updated_any:
            return setup_site_proxy(domain, proxysite)

        # 6. 验证 Web 服务配置语法并重载
        if public.get_webserver() == 'nginx' and os.path.exists('/www/server/nginx/sbin/nginx'):
            chk = subprocess.run(
                ['/www/server/nginx/sbin/nginx', '-t'],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=5
            )
            if chk.returncode != 0:
                # 语法校验失败则回滚所有修改
                for fpath, old_content in backups:
                    with open(fpath, 'w', encoding='utf-8') as f:
                        f.write(old_content)
                err_msg = chk.stderr.decode('utf-8', errors='ignore').strip()
                return False, f"Nginx 配置语法校验失败，已回滚修改: {err_msg}"

        # 7. 同步更新 /www/server/panel/data/proxyfile.json
        proxyfile = '/www/server/panel/data/proxyfile.json'
        if os.path.exists(proxyfile):
            try:
                with open(proxyfile, 'r', encoding='utf-8') as f:
                    pdata = json.load(f)
                if isinstance(pdata, list):
                    changed = False
                    for item in pdata:
                        if item.get('sitename', '').strip().lower() == domain.lower():
                            if item.get('proxydir', '/') == '/' or not changed:
                                item['proxysite'] = proxysite
                                item['type'] = 1
                                changed = True
                    if changed:
                        with open(proxyfile, 'w', encoding='utf-8') as f:
                            json.dump(pdata, f, ensure_ascii=False, indent=2)
            except Exception:
                pass

        # 8. 重载 Web 服务使配置生效
        public.serviceReload()
        return True, proxysite
    except Exception as e:
        for fpath, old_content in backups:
            try:
                with open(fpath, 'w', encoding='utf-8') as f:
                    f.write(old_content)
            except Exception:
                pass
        return False, str(e)


def resolve_site_target(target):
    """
    将用户传入的站点 ID 或域名解析为 aaPanel 主站点名称：
    返回 (site_dict, error_msg)
    """
    if not public:
        return None, "未检测到 aaPanel 核心环境"

    target_str = str(target).strip()
    if not target_str:
        return None, "站点 ID 或域名不能为空"

    # 1. 如果是纯数字，按站点 ID 查询
    if re.match(r'^\d+$', target_str):
        site = public.M('sites').where('id=?', (int(target_str),)).find()
        if site:
            return site, None
        return None, f"未在 aaPanel 中找到 ID 为 [{target_str}] 的站点"

    # 2. 按主站点名查询
    dom_lower = target_str.lower()
    site = public.M('sites').where('name=?', (dom_lower,)).find()
    if site:
        return site, None

    # 3. 按绑定域名表查询 (支持通过别名域名定位主站点)
    dom_rec = public.M('domain').where('name=?', (dom_lower,)).find()
    if dom_rec and dom_rec.get('pid'):
        site = public.M('sites').where('id=?', (dom_rec['pid'],)).find()
        if site:
            return site, None

    return None, f"未在 aaPanel 中找到域名为 [{target_str}] 的站点"


def configure_site_ssl(domain):
    """
    为 aaPanel 站点配置默认 SSL：
    1. 优先复用本机已有的通配符证书或对应 Zone 证书 (如 *.example.com)
    2. 若无可用证书，使用 openssl 自动生成 10 年自签名 Origin 证书 (支持 Cloudflare Full SSL)
    3. 写入 /www/server/panel/vhost/cert/{domain}/
    4. 调用 aaPanel 核心 SetSSLConf 将证书绑定到 Nginx 站点 (开启 443 端口与 HTTPS 协议)
    """
    if not panelSite or not public:
        return False, "未检测到 aaPanel 环境"

    cert_dir = f"/www/server/panel/vhost/cert/{domain}"
    fullchain_path = f"{cert_dir}/fullchain.pem"
    privkey_path = f"{cert_dir}/privkey.pem"

    os.makedirs(cert_dir, exist_ok=True)

    # 1. 如果已存在有效证书，直接跳过生成
    has_valid_cert = False
    if os.path.exists(fullchain_path) and os.path.exists(privkey_path):
        if os.path.getsize(fullchain_path) > 100 and os.path.getsize(privkey_path) > 100:
            has_valid_cert = True

    # 2. 尝试从本地寻找匹配的证书 (如父域名通配符证书)
    if not has_valid_cert:
        matched_src = None
        parts = domain.split('.')
        for i in range(1, len(parts) - 1):
            parent_zone = '.'.join(parts[i:])
            cand = f'/www/server/panel/vhost/ssl/{parent_zone}'
            if os.path.exists(f'{cand}/fullchain.pem') and os.path.exists(f'{cand}/privkey.pem'):
                matched_src = cand
                break

        if not matched_src:
            import glob
            for cand in glob.glob('/www/server/panel/vhost/cert/*'):
                if cand != cert_dir and os.path.exists(f'{cand}/fullchain.pem') and os.path.exists(f'{cand}/privkey.pem'):
                    try:
                        out = subprocess.check_output(
                            ['openssl', 'x509', '-in', f'{cand}/fullchain.pem', '-noout', '-text'],
                            timeout=2
                        ).decode('utf-8')
                        for i in range(1, len(parts) - 1):
                            parent_zone = '.'.join(parts[i:])
                            if f'*.{parent_zone}' in out or domain in out:
                                matched_src = cand
                                break
                    except Exception:
                        continue
                if matched_src:
                    break

        if matched_src:
            import shutil
            shutil.copy2(f'{matched_src}/fullchain.pem', fullchain_path)
            shutil.copy2(f'{matched_src}/privkey.pem', privkey_path)
            has_valid_cert = True
        else:
            # 3. 自动生成自签名 Origin 证书 (10年有效期)
            cmd = [
                'openssl', 'req', '-x509', '-nodes', '-days', '3650',
                '-newkey', 'rsa:2048',
                '-keyout', privkey_path,
                '-out', fullchain_path,
                '-subj', f"/C=US/ST=CA/L=San Francisco/O=CloudFlare Origin/CN={domain}"
            ]
            try:
                subprocess.check_call(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                has_valid_cert = True
            except Exception as e:
                return False, f"生成 SSL 证书失败: {str(e)}"

    # 4. 绑定证书到站点 Nginx 配置
    try:
        ps = panelSite.panelSite()
        get = public.dict_obj()
        get.siteName = domain
        res = ps.SetSSLConf(get)
        if isinstance(res, dict) and res.get('status') is False:
            return False, res.get('msg', 'SetSSLConf 绑定失败')
        return True, "SSL 证书已配置并成功启用 (443端口开启)"
    except Exception as e:
        return False, f"绑定 SSL 配置异常: {str(e)}"


